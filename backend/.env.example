# Database (Docker default from docker-compose.yml)
DATABASE_URL="postgresql://user:password@localhost:55432/js_ashanti_db"

# Server Configuration
PORT=4001

# AI (Groq)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend)
RESEND_API_KEY=""

# Payments (Paystack) — optional.
# Leave blank to use the built-in payment SIMULATION.
# When set, checkout uses Paystack hosted checkout (Mobile Money + cards).
# Get TEST keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""
# Set your webhook URL in the Paystack dashboard to: <BACKEND_URL>/api/payments/webhook

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4001"
FRONTEND_URL="http://localhost:3000"
# Optional comma-separated origins for Expo on a device/LAN (e.g. http://192.168.1.5:8081)
BETTER_AUTH_ADDITIONAL_ORIGINS=""
ADMIN_ID="" # ID of the first admin account

# Social Authentication (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NODE_ENV="development"
