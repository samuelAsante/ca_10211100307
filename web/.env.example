# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:4001

# App URL (Frontend)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Better-Auth URL
BETTER_AUTH_URL=http://localhost:4001

# Optional: internal API URL used by Next.js server-side fetches in Docker
# BACKEND_INTERNAL_URL=http://backend:4001

# Cloudinary (Frontend settings) — optional; product image uploads stay disabled without it
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Set to true only after Google OAuth credentials are configured on the backend
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
